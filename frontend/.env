# Spring Boot Microservices Backend API Endpoints
# In development, these point through Vite's dev proxy

# Direct Service Ports
VITE_API_GATEWAY_URL=http://localhost:8090
VITE_BANKING_SERVICE_URL=http://localhost:8081
VITE_PAYROLL_SERVICE_URL=http://localhost:8082
VITE_CHATBOT_SERVICE_URL=http://localhost:8083
VITE_EUREKA_SERVER_URL=http://localhost:8761

# Dev Proxy Paths (Preferred for local development to bypass CORS)
VITE_USE_DEV_PROXY=true

# Mock Fallback: When false, defaults directly to Live Spring Boot & MySQL backend
VITE_DEFAULT_MOCK_FALLBACK=false

# Application Metadata
VITE_APP_NAME=Apex Banking Microservices
VITE_APP_VERSION=1.0.0
# Production Environment Configuration
VITE_ENV=production
# In production, usually requests go through the API Gateway or reverse proxy (Nginx/Cloud Gateway)
VITE_API_GATEWAY_URL=/api/gateway
VITE_BANKING_SERVICE_URL=/api/banking
VITE_PAYROLL_SERVICE_URL=/api/payroll
VITE_CHATBOT_SERVICE_URL=/api/chatbot
VITE_EUREKA_SERVER_URL=/eureka
VITE_USE_DEV_PROXY=false
VITE_DEFAULT_MOCK_FALLBACK=false
